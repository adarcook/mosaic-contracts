{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/sync/event-envelope.v1.schema.json",
  "title": "Event Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "recordedAt", "producer", "subjectId", "payload", "source"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {
      "enum": [
        "nutrition.meal.recorded",
        "nutrition.meal.updated",
        "nutrition.meal.deleted",
        "inventory.consumption.requested"
      ]
    },
    "eventVersion": {"const": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "correlationId": {"type": ["string", "null"], "format": "uuid"},
    "causationId": {"type": ["string", "null"], "format": "uuid"},
    "payload": {"type": "object"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "localRecordId"],
      "properties": {
        "deviceId": {"type": "string", "minLength": 1},
        "localRecordId": {"type": "string", "minLength": 1}
      }
    }
  }
}
