{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/sync/sync-batch.v1.schema.json",
  "title": "Sync Batch V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "batchId", "clientId", "createdAt", "events"],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "batchId": {"type": "string", "format": "uuid"},
    "clientId": {"type": "string", "minLength": 1},
    "checkpoint": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "event-envelope.v1.schema.json"}
    }
  }
}
