{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/inventory/consumption-request.v1.schema.json",
  "title": "Inventory Consumption Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "mealId", "requestedAt", "items", "status"],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "requestId": {"type": "string", "format": "uuid"},
    "mealId": {"type": "string", "format": "uuid"},
    "requestedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["proposed", "confirmed", "rejected"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mealComponentId", "inventoryItemId", "quantity", "unit", "conversionStatus"],
        "properties": {
          "mealComponentId": {"type": "string", "format": "uuid"},
          "inventoryItemId": {"type": "string", "format": "uuid"},
          "quantity": {"type": "number", "exclusiveMinimum": 0},
          "unit": {"enum": ["g", "ml", "piece", "serving", "tbsp", "tsp", "cup"]},
          "conversionStatus": {"enum": ["not_required", "estimated", "user_confirmed", "unresolved"]},
          "sourcePreparationState": {"enum": ["raw", "cooked", "prepared", "unknown"]},
          "inventoryPreparationState": {"enum": ["raw", "cooked", "prepared", "unknown"]},
          "notes": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
